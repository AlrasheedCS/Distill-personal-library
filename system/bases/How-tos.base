filters:
  and:
  - file.inFolder("howto")
  - file.ext == "md"
  - type == "howto"
  - example != true
properties:
  file.name:
    displayName: How-to
views:
- type: table
  name: All how-tos
  order: &id001
  - file.name
  - tested
  - status
  - topics
  - saved
- type: table
  name: Not tested yet
  order: *id001
  filters:
    and:
    - tested != true
